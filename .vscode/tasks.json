{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "setup (functions)",
			"type": "shell",
			"command": "python",
			"args": [
				"-m",
				"venv",
				".venv"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": []
		},
		{
			"label": "install dependencies (functions)",
			"type": "process",
			"command": "${workspaceFolder}/${config:azureFunctions.pythonVenv}/bin/python",
			"windows": {
				"command": "${workspaceFolder}/${config:azureFunctions.pythonVenv}/Scripts/python.exe"
			},
			"args": [
				"-m",
				"pip",
				"install",
				"-r",
				"requirements.txt"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"dependsOn": "setup (functions)",
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"problemMatcher": []
		},
		{
			"type": "func",
			"label": "func: host start",
			"command": "host start",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"isBackground": true,
			"dependsOn": "install dependencies (functions)",
			"problemMatcher": "$func-python-watch"
		}
	]
}